---
// Page shell shared by every Dispatch page: fonts, theme bootstrap (reads the
// same localStorage key as the map app so dark mode follows the user across
// the site), the camo header, and the footer.
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/dispatch.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = 'Texas inshore fishing, once a week: catch reports, conditions, tactics, and conservation.', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Slackwater Dispatch" href={`${base}rss.xml`} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Slackwater Dispatch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yellowtail&family=Big+Shoulders+Display:wght@700;800;900&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
      // Theme before first paint. Mirrors js/settings.js in the map app.
      (function () {
        try {
          var s = JSON.parse(localStorage.getItem('slackwater.settings') || '{}');
          var a = s.appearance || 'system';
          var dark = a === 'dark' || (a === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <span class="brand">Slackwater</span>
        <span>Dispatch is written on the Texas coast. Tides and weather from NOAA CO-OPS and the National Weather Service.</span>
        <nav aria-label="Footer">
          <a href="/">Map</a>
          <a href={base}>Dispatch</a>
          <a href={`${base}rss.xml`}>RSS</a>
          <a href="https://apps.apple.com/us/app/id6785986784" rel="noopener" target="_blank">iOS app</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
