---
// /dispatch/ — the latest issue in full, then the archive.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Issue from '../components/Issue.astro';

const issues = (await getCollection('issues', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = issues[0];
const past = issues.slice(1);
const base = import.meta.env.BASE_URL;
---
<Base
  title={latest ? `Dispatch No. ${latest.data.number} — ${latest.data.title}` : 'Slackwater Dispatch'}
  description={latest?.data.summary}
>
  <main class="wrap">
    {latest ? <Issue issue={latest} /> : (
      <div class="empty">
        <span class="mark">Dispatch</span>
        <p>First issue is on the way.</p>
      </div>
    )}

    {past.length > 0 && (
      <nav class="archive" aria-label="Past issues">
        <h2>Past issues</h2>
        <ol>
          {past.map((i) => (
            <li>
              <a href={`${base}${i.id}/`}>
                <span class="no">No. {i.data.number}</span>
                <span class="t">{i.data.title}</span>
                <time datetime={i.data.date.toISOString().slice(0, 10)}>
                  {i.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
                </time>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </main>
</Base>
